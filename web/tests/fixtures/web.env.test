### MainSettings

# Clé secrète utilisée notamment pour la protection CSRF et la signature
# des liens d'invitation. Cette clé
# DOIT être différente pour TOUTES les instances de B3Desk, et être tenue
# secrète. Peut être générée avec ``python -c 'import secrets;
# print(secrets.token_hex())'``
#
# Plus d'infos sur
# https://flask.palletsprojects.com/en/3.0.x/config/#SECRET_KEY
SECRET_KEY='test-secret-key'

# Le nom de domaine sur lequel est déployé l'instance B3Desk.
#
# Par exemple ``b3desk.example.org``, sans `https://`.
#
# Plus d'infos sur https://flask.palletsprojects.com/en/3.0.x/config/#SERVER_NAME.
SERVER_NAME='b3desk.test'

# La méthode préférée utilisée pour générer des URL. Peut être `http` ou
# `https`.
#
# Plus d'infos sur
# https://flask.palletsprojects.com/en/3.0.x/config/#PREFERRED_URL_SCHEME.
PREFERRED_URL_SCHEME='http'

# Nom du cookie de session.
#
# Par défaut, il dépend de la version mineure de B3Desk, par exemple
# ``session_1_8``. Les utilisateurs sont donc déconnectés à chaque mise à jour
# mineure, ce qui évite de lire des sessions écrites par une version précédente.
#
# Plus d'infos sur
# https://flask.palletsprojects.com/en/3.0.x/config/#SESSION_COOKIE_NAME.
SESSION_COOKIE_NAME='session'

# Ajoute l'attribut ``Secure`` au cookie de session : le navigateur ne
# l'envoie alors qu'en HTTPS. Par défaut, il est ajouté si
# ``PREFERRED_URL_SCHEME`` vaut ``https``.
#
# Plus d'infos sur
# https://flask.palletsprojects.com/en/3.0.x/config/#SESSION_COOKIE_SECURE.
# SESSION_COOKIE_SECURE=

# Valeur de l'attribut ``SameSite`` du cookie de session. ``Strict``
# empêche le retour depuis le fournisseur d'identité.
#
# Plus d'infos sur
# https://flask.palletsprojects.com/en/3.0.x/config/#SESSION_COOKIE_SAMESITE.
# SESSION_COOKIE_SAMESITE='Lax'

# Durée de vie d'une session en secondes. Elle court à partir de la
# connexion et n'est pas prolongée par l'activité.
# PERMANENT_SESSION_LIFETIME=604800

# Chemin vers un fichier de configuration de logs Python.
#
# Le fichier doit être au :ref:`format de fichiers de logs officiel Python <logging-config-fileformat>`.
# Il peut être au format INI ou à partir de Python 3.11 au format TOML (qui est recommandé):
#
# .. tip:: Par défaut les images Docker montent le répertoire ``web/conf`` dans ``/opt/bbb-visio/conf``.
#     On peut donc créer un fichier ``web/conf/logging.toml`` dans le projet avec la configuration voulue.
#     On indiquera ensuite ``LOG_CONFIG=/opt/bbb-visio/conf/logging.toml`` pour que ce fichier soit chargé
#     par l'image Docker.
#
# .. note:: `[root]` désigne un logger par défaut qui traite tous les messages de log qui ne sont pas traités par d'autres loggers.
#
# .. code-block:: toml
#     :caption: Exemple de fichier de configuration de logs au format toml
#
#     version = 1
#
#     [formatters.default]
#     format = "[%(asctime)s] %(levelname)s in %(module)s: %(message)s"
#
#     [handlers.wsgi]
#     class = "logging.handlers.WatchedFileHandler"
#     filename = "/var/log/wsgi.log"
#     formatter = "default"
#
#     [handlers.b3desk]
#     class = "logging.handlers.WatchedFileHandler"
#     filename = "/var/log/b3desk.log"
#     formatter = "default"
#
#     [loggers.b3desk]
#     level = "INFO"
#     handlers = ["b3desk"]
#
#     [root]
#     level = "INFO"
#     handlers = ["wsgi"]
#
# .. code-block:: toml
#     :caption: Exemple de configuration avec un fichier destiné aux erreurs
#
#     version = 1
#
#     [formatters.default]
#     format = "[%(asctime)s] %(levelname)s in %(module)s: %(message)s"
#
#     [handlers.wsgi]
#     class = "logging.handlers.WatchedFileHandler"
#     filename = "/var/log/wsgi.log"
#     formatter = "default"
#
#     [handlers.b3desk]
#     class = "logging.handlers.WatchedFileHandler"
#     filename = "/var/log/b3desk.log"
#     formatter = "default"
#
#     [handlers.errors]
#     class = "logging.handlers.WatchedFileHandler"
#     filename = "/var/log/errors.log"
#     formatter = "default"
#     level = "WARNING"
#
#     [loggers.b3desk]
#     level = "INFO"
#     handlers = ["b3desk", "errors"]
#
#     [root]
#     level = "INFO"
#     handlers = ["wsgi"]
#
# .. code-block:: toml
#     :caption:
#         Exemple de configuration avec les logs BBB dans un fichier dédié,
#         avec DEBUG sur le module BBB uniquement.
#
#     version = 1
#
#     [formatters.default]
#     format = "[%(asctime)s] %(levelname)s in %(module)s: %(message)s"
#
#     [handlers.wsgi]
#     class = "logging.handlers.WatchedFileHandler"
#     filename = "/var/log/wsgi.log"
#     formatter = "default"
#
#     [handlers.bbb]
#     class = "logging.handlers.WatchedFileHandler"
#     filename = "/var/log/bbb.log"
#     formatter = "default"
#
#     [loggers.bbb]
#     level = "DEBUG"
#     handlers = ["bbb"]
#
#     [loggers.b3desk]
#     level = "INFO"
#     handlers = ["wsgi"]
#
#     [root]
#     level = "INFO"
#     handlers = ["wsgi"]
# LOG_CONFIG=

# L’URL du serveur redis utilisé pour les tâches asynchrones, le cache et
# les sessions. Si non renseigné, le cache et les sessions sont stockés sur
# le système de fichiers local, qui n'est pas partagé entre plusieurs
# serveurs.
#
# Par exemple ``localhost:6379``, ou une URL complète comme
# ``rediss://:motdepasse@redis.example.org:6379/0``.
# REDIS_URL=

# Durée en jours avant l’expiration des autorisations Nextcloud.
# NC_LOGIN_TIMEDELTA_DAYS=30

# URL du fournisseur d'accès utilisé par Nextcloud.
#
# Par exemple ``https://auth.example.org``.
# NC_LOGIN_API_URL=

# Clé d'API Nextcloud.
# NC_LOGIN_API_KEY=

# Force le protocole https pour les URLs Nextcloud.
# FORCE_HTTPS_ON_EXTERNAL_URLS=false

# Chemin vers le dossier dans lequel seront stockés les fichiers
# téléversés par les utilisateurs.
UPLOAD_DIR='/tmp/b3desk/upload'

# Chemin vers un dossier qui servira de stockage temporaire de fichiers
# entre Nextcloud et BBB.
TMP_DOWNLOAD_DIR='/tmp/b3desk/download'

# Taille maximum des fichiers téléversés, en octets.
# MAX_SIZE_UPLOAD=20000000

# Format des dates utilisées lors des échanges avec l’API de Nextcloud.
#
# Plus d’informations sur
# https://docs.python.org/fr/3/library/datetime.html#strftime-and-strptime-format-codes
# TIME_FORMAT='%Y-%m-%d'

# Mode tests unitaires, à ne surtout pas utiliser en production.
#
# Plus d’informations sur
# https://flask.palletsprojects.com/en/3.0.x/config/#TESTING
# TESTING=false

# Mode debug, à ne surtout pas utiliser en production.
#
# Plus d’informations sur
# https://flask.palletsprojects.com/en/3.0.x/config/#DEBUG
# DEBUG=false

# Titre HTML par défaut pour les pages HTML.
# TITLE='BBB-Visio'

# Description dans BBB des fichiers téléversés dans Nextcloud.
# EXTERNAL_UPLOAD_DESCRIPTION='Fichiers depuis votre Nextcloud'

# Indique en secondes la durée de validité des jetons CSRF.
#
# Il est nécessaire de mettre une valeur plus élevée que le délai de
# mise en cache des pages par le serveur web. Sans quoi les
# navigateurs des utilisateurs serviront des pages en caches contenant
# des jetons CSRF expirés.
#
# Plus d'infos sur
# https://flask-wtf.readthedocs.io/en/1.2.x/config/
# WTF_CSRF_TIME_LIMIT=86400

# Un ou plusieurs chemins vers les répertoires des catalogues de
# traduction, séparés par des « ; ».
#
# Plus d’infos sur
# https://python-babel.github.io/flask-babel/#configuration
# BABEL_TRANSLATION_DIRECTORIES='/opt/bbb-visio/translations'

# La langue utilisée par défaut lorsque l’utilisateur n’en a pas choisi.
# BABEL_DEFAULT_LOCALE='fr'

# Le fuseau horaire utilisé pour l’affichage des dates et heures.
#
# Plus d'infos sur https://data.iana.org/time-zones/tzdb-2021a/zone1970.tab
# BABEL_DEFAULT_TIMEZONE='Europe/Paris'

# Le nombre maximum de séminaires que peut créer un utilisateur.
# MAX_MEETINGS_PER_USER=50

# Liste de mime-types acceptés par le serveur pour le téléversement de
# fichiers.
#
# Si non renseigné, tous les fichiers sont autorisés.
# ALLOWED_MIME_TYPES_SERVER_SIDE='["application/pdf","image/vnd.dwg","image/x-xcf","image/jpeg","image/jpx","image/png","image/apng","image/gif","image/webp","image/x-canon-cr2","image/tiff","image/bmp","image/vnd.ms-photo","image/vnd.adobe.photoshop","image/x-icon","image/heic","image/avif","application/msword","application/vnd.openxmlformats-officedocument.wordprocessingml.document","application/vnd.oasis.opendocument.text","application/vnd.ms-excel","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","application/vnd.oasis.opendocument.spreadsheet","application/vnd.ms-powerpoint","application/vnd.openxmlformats-officedocument.presentationml.presentation","application/vnd.oasis.opendocument.presentation"]'

# Liste de mime-types autorisés par le navigateur pour le téléversement
# des fichiers, séparés par des virgules.
#
# Passé en paramètre ``acceptedFiles`` de *Dropzone*.
#
# Plus d’infos sur https://docs.dropzone.dev/configuration/basics/configuration-options
# ACCEPTED_FILES_CLIENT_SIDE='image/*,.pdf,.doc,.docx,.htm,.html,.odp,.ods,.odt,.ppt,.pptx,.xls,.xlsx'

# Liste des scopes OpenID Connect pour lesquels une autorisation sera
# demandée au serveur d’identité, séparés par des virgules.
#
# .. code-block:: toml
#     :caption: Exemple dans un fichier de configuration TOML
#
#     OIDC_SCOPES = "openid, email, profile, siret, usual_name"
#
# .. code-block:: shell
#     :caption: Exemple en variable d’environnement
#
#     OIDC_SCOPES="openid,email,profile,siret,usual_name"
# OIDC_SCOPES='openid,email,profile'

# Correspondance entre les champs utilisateur de B3Desk (clés) et les
# claims renvoyés par le serveur d’identité (valeurs).
#
# Permet d’adapter B3Desk à des serveurs OIDC qui n’utilisent pas les
# claims standards, par exemple ProConnect où le nom de famille est
# renvoyé dans le claim ``usual_name`` plutôt que ``family_name``.
#
# Les champs utilisateurs supportés sont ``given_name``, ``family_name``,
# ``email`` et ``preferred_username``. Tout champ absent de la
# configuration est lu directement depuis le claim de même nom.
#
# Si laissé vide (valeur par défaut), aucun mapping n’est appliqué et
# les claims sont lus tels quels.
#
# .. code-block:: shell
#     :caption: Exemple en variable d’environnement
#
#     OIDC_CLAIMS_MAPPING='{"given_name":"given_name","family_name":"usual_name","email":"email"}'
# OIDC_CLAIMS_MAPPING='{}'

# URL du serveur d’identité des organisateurs de réunion.
#
# Par exemple : https://auth.example.com
OIDC_ISSUER='https://iam.test'

# ID du client auprès du serveur d’identité des organisateurs.
OIDC_CLIENT_ID='test-client-id'

# Secret permettant d’identifier le client auprès du serveur d’identité
# des organisateurs.
OIDC_CLIENT_SECRET='test-client-secret'

# Méthode de communication avec le point d’entrée ``token_endpoint`` du
# serveur d’identité des organisateurs.
# OIDC_CLIENT_AUTH_METHOD='client_secret_post'

# Méthode de communication avec le point d’entrée d’introspection
# ``token_introspection`` du serveur d’identité des organisateurs.
#
# ``client_secret_basic`` ou ``client_secret_post``. ProConnect demande
# ``client_secret_post``.
# OIDC_INTROSPECTION_AUTH_METHOD='client_secret_basic'

# Indique si le serveur d’authentification des participants est activé ou
# non.
#
# Si le serveur est KO, en passant cette variable à ``False``,
# l’authentification ne sera plus nécessaire pour les liens d’invitation authentifiés, ce qui permet de faire en sorte que les liens restent valides.
# OIDC_ATTENDEE_ENABLED=true

# URL du serveur d’identité des participants authentifiés.
#
# Si non renseigné, prend la valeur de ``OIDC_ISSUER``.
# OIDC_ATTENDEE_ISSUER=

# ID du client auprès du serveur d’identité des participants authentifiés.
#
# Si non renseigné, prend la valeur de ``OIDC_CLIENT_ID``.
# OIDC_ATTENDEE_CLIENT_ID=

# Secret permettant d’identifier le client auprès du serveur d’identité
# des participants authentifiés.
#
# Si non renseigné, prend la valeur de ``OIDC_CLIENT_SECRET``.
# OIDC_ATTENDEE_CLIENT_SECRET=

# Méthode de communication avec le point d’entrée ``token_endpoint`` du
# serveur d’identité des participants authentifiés.
#
# Si non renseigné, prend la valeur de ``OIDC_CLIENT_AUTH_METHOD``.
# OIDC_ATTENDEE_CLIENT_AUTH_METHOD=

# Nom du service d’authentification des participants authentifiés. Utilisé
# pour l’affichage dans la modale d’invitation de participants authentifés.
# OIDC_ATTENDEE_SERVICE_NAME=

# Liste des scopes OpenID Connect pour lesquels une autorisation sera
# demandée au serveur d’identité des participants authentifiés, séparés par
# des virgules.
#
# Si non renseigné, prend la valeur de ``OIDC_SCOPES``.
# OIDC_ATTENDEE_SCOPES=

# Correspondance entre les champs utilisateur de B3Desk (clés) et les
# claims renvoyés par le serveur d’identité des participants authentifiés
# (valeurs).
#
# Si non renseigné, prend la valeur de ``OIDC_CLAIMS_MAPPING``.
#
# .. code-block:: shell
#     :caption: Exemple en variable d’environnement
#
#     OIDC_ATTENDEE_CLAIMS_MAPPING='{"given_name":"given_name","family_name":"usual_name"}'
# OIDC_ATTENDEE_CLAIMS_MAPPING='{}'

# URL du serveur d’identité des admins.
#
# Par exemple : https://auth.example.com
# OIDC_ADMIN_ISSUER=

# ID du client auprès du serveur d’identité des admins.
# OIDC_ADMIN_CLIENT_ID=

# Secret permettant d’identifier le client auprès du serveur d’identité
# des admins.
# OIDC_ADMIN_CLIENT_SECRET=

# Méthode de communication avec le point d’entrée ``token_endpoint`` du
# serveur d’identité des admins.
# OIDC_ADMIN_CLIENT_AUTH_METHOD='client_secret_post'

# Liste des scopes OpenID Connect pour lesquels une autorisation sera
# demandée au serveur d’identité des admins, séparés par des virgules.
#
# Plus d’infos sur https://flask-pyoidc.readthedocs.io/en/latest/api.html#module-flask_pyoidc.provider_configuration
# OIDC_ADMIN_SCOPES=

# Nom du groupe d'administration
# Les comptes appartenant à ce groupe auront les droits d'administration.
# OIDC_ADMIN_GROUP='admin'

# Enable the admin backoffice.
#
# When on, admin can login.
# OIDC_ADMIN_ENABLED=false

# Durée de vie de la session admin en secondes. Elle court à partir de la
# connexion et n'est pas prolongée par l'activité.
# OIDC_ADMIN_SESSION_LIFETIME=3600

# Indique si un second serveur d'identité pour la connection a un
# Nextcloud est activée.
#
# S'il y a bien besoin de ce second serveur d'identité pour connecter
# un utilisateur sur un Nextcloud, l'identifiant Nextcloud de
# l'utilisateur sera recherché à partir de son mail.
# SECONDARY_IDENTITY_PROVIDER_ENABLED=false

# Url du serveur d'identité permettant de retrouver un id utilisateur à
# partir de son email.
# SECONDARY_IDENTITY_PROVIDER_URI=

# Groupe sous lequel est enregistré l'utilisateur.
# SECONDARY_IDENTITY_PROVIDER_REALM=

# ID du client B3desk dans ce serveur d'identité.
# SECONDARY_IDENTITY_PROVIDER_CLIENT_ID=

# Secret du client B3desk dans ce serveur d'identité.
# SECONDARY_IDENTITY_PROVIDER_CLIENT_SECRET=

# Surcharge l’adresse de la page de documentation si renseigné.
# DOCUMENTATION_LINK_URL=

# Semble inutilisé.
# DOCUMENTATION_LINK_LABEL=

# Nom du service B3Desk.
# SERVICE_TITLE='Webinaire'

# Slogan du service B3Desk.
# SERVICE_TAGLINE='Le service de webinaire pour les agents de l’État'

# URL vers laquelle sont redirigés les utilisateurs après un séminaire.
# MEETING_LOGOUT_URL=

# URL de l’iframe du formulaire de satisfaction.
# SATISFACTION_POLL_URL=

# URI de configuration de la base de données.
#
# Par exemple ``postgresql://user:password@localhost:5432/bbb_visio``
SQLALCHEMY_DATABASE_URI='postgresql://user:password@postgres/b3desk'

# Variante de locale pour le vocabulaire des réunions.
#
# Peut être ``cours`` ou ``seminaire``.
# Si vide : réunion par défaut.
# MEETING_LOCALE_VARIANT=''

# Formulation du sous-titre de la page de création de réunion.
# WELCOME_PAGE_SUBTITLE='Mes salles de réunion'

# Formulation du titre du mail d’invitation à une réunion.
# MEETING_MAIL_SUBJECT='Invitation à une réunion en ligne immédiate du Webinaire de l’Etat'

# Active la fonctionnalité de téléversement de fichiers.
# FILE_SHARING=false

# Sous-titre de la page de documentation.
# DOCUMENTATION_PAGE_SUBTITLE=

# Affiche le lien de création de réunions improvisées.
# QUICK_MEETING=true

# Nom par défaut des réunions improvisées.
# QUICK_MEETING_DEFAULT_NAME='Réunion improvisée'

# Formulation de « Lien Modérateur » dans les liens BBB.
# QUICK_MEETING_MODERATOR_LINK_INTRODUCTION=' Lien Modérateur  '

# Formulation de « Lien Participant » dans les liens BBB.
# QUICK_MEETING_ATTENDEE_LINK_INTRODUCTION=' Lien Participant  '

# Formulation du message d’accueil aux modérateurs dans BBB.
# QUICK_MEETING_MODERATOR_WELCOME_MESSAGE='Bienvenue aux modérateurs. Pour inviter quelqu\'un à cette réunion, envoyez-lui l\'un de ces liens :'

# Lien vers lequel sont redirigés les participants à la fin d’une réunion
# improvisée.
#
# Par défaut, c'est la page d'accueil du service B3Desk.
# QUICK_MEETING_LOGOUT_URL=

# Affiche des liens vers les adresses email des modérateurs et
# participants dans la liste des réunions.
# MAILTO_LINKS=false

# Affichage court des listes de réunions.
# SHORTY=false

# Semble inutilisé.
# CLIPBOARD=false

# Active la fonctionnalité d’enregistrement des réunions.
# RECORDING=false

# Durée par défaut de conservation des enregistrements.
#
# Utilisé à des fins d’affichage seulement.
# RECORDING_DURATION='P1Y'

# Active l'encart « Bêta » dans l'entête du service B3Desk.
# BETA=false

# Adresse email d’expéditeur pour les mails d’invitation.
# SMTP_FROM=

# Addresse du serveur SMTP.
# SMTP_HOST=

# Port du serveur SMTP.
# SMTP_PORT=

# Identifiant auprès du serveur SMTP.
# SMTP_USERNAME=

# Mot de passe du serveur SMTP.
# SMTP_PASSWORD=

# Connexion SSL au serveur SMTP.
# SMTP_SSL=false

# Connexion StartTLS au serveur SMTP.
# SMTP_STARTTLS=false

# Délai d’attente en secondes de chaque échange avec le serveur SMTP.
#
# Le délai s’applique à la connexion puis à chaque réponse du serveur, et non
# à la session entière. Sans lui, un serveur qui accepte la connexion sans
# jamais répondre bloque indéfiniment le processus appelant.
# SMTP_TIMEOUT=10

# Durée maximum en minutes des réunion passée à l'API BBB.
#
# Plus d’informations sur
# https://docs.bigbluebutton.org/development/api/#create
# DEFAULT_MEETING_DURATION=280

# Plages d’adresses IP du réseau interministériel de l'État.
#
# Affiche un encart particulier pour les utilisateurs se connectant
# depuis ce réseau.
# RIE_NETWORK_IPS=

# Nombre moyen de participants indicatif sur la plateforme.
#
# Seulement utilisé à des fins d’affichage.
# MAX_PARTICIPANTS=200

# Durée de rétention du cache des statistiques des réunions.
# STATS_CACHE_DURATION=1800

# URL du fichier de statistiques des réunions.
#
# Par exemple ``https://visio-test.education.fr/static/local/stats.csv``
# STATS_URL=

# Numéro de ligne des statistiques de réunion dans le fichier CSV.
# STATS_INDEX=2

# URL du service BBB.
#
# Par exemple ``https://bbb30.test/bigbluebutton/api``
BIGBLUEBUTTON_ENDPOINT='https://bbb.test'

# Mot de passe du service BBB.
BIGBLUEBUTTON_SECRET='test-bbb-secret'

# The dial access number that participants can call in using regular
# phone.
#
# Required if pin management is enabled.
# BIGBLUEBUTTON_DIALNUMBER=

# Passé à l'API BBB via le paramètre ``meta_analytics-callback-url``.
#
# Plus d’informations sur
# https://docs.bigbluebutton.org/development/api/#create
# BIGBLUEBUTTON_ANALYTICS_CALLBACK_URL=

# Le temps de mise en cache (en secondes) des réponses aux requêtes GET à
# l'API BBB.
# BIGBLUEBUTTON_API_CACHE_DURATION=5

# BBB request timeout
#
# Timeout for BBB request expressed in seconds in logs
# BIGBLUEBUTTON_REQUEST_TIMEOUT=2

# Délai minimum (en secondes) avant l'envoi du mail notifiant la
# disponibilité d'un enregistrement.
#
# BBB envoie un callback par format de rendu publié (``presentation``,
# ``video``...). Aucune notification n'est envoyée avant l'expiration de ce
# délai, décompté depuis le premier callback reçu pour un enregistrement,
# même si tous les formats attendus sont déjà disponibles. Il laisse à BBB le
# temps de publier les formats rapides avant l'envoi.
# RECORDING_NOTIFICATION_MIN_DELAY=60

# Délai maximum (en secondes) avant l'envoi du mail notifiant la
# disponibilité d'un enregistrement.
#
# En fonctionnement nominal, le mail est envoyé dès que tous les formats
# attendus sont disponibles (et que le délai minimum est écoulé). Passé ce
# délai maximum, décompté depuis le premier callback, le mail est envoyé avec
# les formats disponibles à cet instant, même si tous les formats attendus ne
# sont pas encore prêts — par exemple un compte-rendu IA qui tarde ou échoue.
# RECORDING_NOTIFICATION_MAX_DELAY=3600

# Formats de lecture attendus pour un enregistrement BBB.
#
# La notification n'est émise qu'une fois tous ces formats disponibles,
# auxquels s'ajoute ``ai-summary`` lorsque le compte-rendu IA est activé pour
# le séminaire. Le format ``ai-summary`` ne doit pas figurer dans cette liste :
# il est ajouté automatiquement selon la configuration de chaque séminaire.
#
# Une instance qui ne produit pas le format ``video`` doit le retirer de cette
# liste, sans quoi la complétude ne sera jamais atteinte et chaque mail
# attendra l'expiration de ``RECORDING_NOTIFICATION_MAX_DELAY``.
# RECORDING_EXPECTED_FORMATS='presentation,video'

# URL de l’instance de Matomo vers laquelle envoyer des statistiques.
# MATOMO_URL=

# ID de l’instance B3Desk dans Matomo.
# MATOMO_SITE_ID=

# Sentry DSN to catch exceptions.
# SENTRY_DSN=

# Enable LaSuite numerique homepage style.
# ENABLE_LASUITENUMERIQUE=false

# Enable mangement of PIN by B3Desk.
#
# PIN allows users joining meeting by phone. BIGBLUEBUTTON_DIALNUMBER
# required if PIN management enabled.
# ENABLE_PIN_MANAGEMENT=false

# FQDN SIP server.
#
# Required if SIP is enabled.
# FQDN_SIP_SERVER=

# Private key generated by joserfc, double quotes are mandatory.
#
# It will be used to generate a token for SIPMediaGW connection
# security. Changing the private-key makes all tokens invalid.
# Required if SIP is enabled.
# PRIVATE_KEY=

# Enable SIPMediaGW.
#
# SIPMediaGW url allows users connecting SIPMediaGW. FQDN_SIP_SERVER
# required if SIP enabled.
# ENABLE_SIP=false

# List of streaming service for video sharing.
# VIDEO_STREAMING_LINKS='{}'

# Piste Oauth client_id
#
# Oauth client id can be retrieved from the PISTE site under APPLICATION on
# the following line: Identifiants Oauth
# PISTE_OAUTH_CLIENT_ID=

# Piste Oauth client_secret
#
# Oauth client secret can be retrieved from the PISTE site under APPLICATION on
# the following line: Identifiants Oauth
# under the following column: Secret Key
# PISTE_OAUTH_CLIENT_SECRET=

# PISTE API url
#
# basic url for PISTE API used to get and check captchetat
# CAPTCHETAT_API_URL='https://api.piste.gouv.fr/piste/'

# PISTE OAUTH APU url
#
# basic url for PISTE OAUTH API used to get access token to captchetat API
# PISTE_OAUTH_API_URL='https://oauth.piste.gouv.fr/api'

# Captcha number attemps
#
# Number of attempts to enter the visio-code before submitting a captcha
# CAPTCHA_NUMBER_ATTEMPTS=5

# Maximum meeting delegates
#
# Maximum number of delegates for one meeting
# MAXIMUM_MEETING_DELEGATES=15

# Contact link
#
# If entered, a 'contact' button wil appear in footer
# CONTACT_LINK=

# Enable AI summary
#
# Allow AI summary generation on records
# ENABLE_AI_SUMMARY=false
